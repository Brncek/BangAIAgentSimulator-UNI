<Window x:Class="BangSimulatorGui.RankingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent Ranking" Width="880" Height="600" MinWidth="720" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="SettingsPanel" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Target="{Binding ElementName=CheckpointFolder}">Checkpoint folder</Label>
            <TextBox x:Name="CheckpointFolder" Grid.Column="1" Margin="8,2" />
            <Button Grid.Column="2" Margin="0,2" Padding="8,1" Click="BrowseFolder_Click">Browse…</Button>
            <Label Grid.Row="1" Target="{Binding ElementName=PythonExecutable}">Python executable</Label>
            <TextBox x:Name="PythonExecutable" Grid.Row="1" Grid.Column="1" Margin="8,2" Text="python" />
            <Button Grid.Row="1" Grid.Column="2" Margin="0,2" Padding="8,1" Click="BrowsePython_Click">Browse…</Button>

            <WrapPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,8,0,0">
                <Label Target="{Binding ElementName=Method}">Method</Label>
                <ComboBox x:Name="Method" Width="115" Margin="0,2,12,2" SelectedIndex="0">
                    <ComboBoxItem Content="Uncertainty" Tag="uncertainty" />
                    <ComboBoxItem Content="Fixed games" Tag="fixed" />
                </ComboBox>
                <Label Target="{Binding ElementName=Pool}">Opponent pool</Label>
                <ComboBox x:Name="Pool" Width="94" Margin="0,2,12,2" SelectedIndex="0">
                    <ComboBoxItem Content="Mixed" Tag="mixed" />
                    <ComboBoxItem Content="Self-play" Tag="self" />
                </ComboBox>
                <Label Target="{Binding ElementName=GameLimit}">Games / checkpoint</Label>
                <TextBox x:Name="GameLimit" Width="68" Margin="0,2,12,2" Text="10000" />
                <Label Target="{Binding ElementName=Precision}">Precision (pp)</Label>
                <TextBox x:Name="Precision" Width="48" Margin="0,2"
                         Text="5">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=Method}" Value="1">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </WrapPanel>
        </Grid>

        <DataGrid x:Name="Leaderboard" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserSortColumns="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="90" />
                <DataGridTextColumn Header="Rank" Binding="{Binding Rank}" Width="50" />
                <DataGridTextColumn Header="Checkpoint" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Wins" Binding="{Binding Wins}" Width="60" />
                <DataGridTextColumn Header="Games" Binding="{Binding Games}" Width="60" />
                <DataGridTextColumn Header="Draws" Binding="{Binding Draws}" Width="60" />
                <DataGridTextColumn Header="Win rate" Binding="{Binding Score}" Width="72" />
                <DataGridTextColumn Header="95% interval" Binding="{Binding Interval}" Width="132" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="RunButton" Width="78" Click="Run_Click">Run</Button>
                <Button x:Name="CancelButton" Width="78" Margin="8,0,0,0" IsEnabled="False" Click="Cancel_Click">Cancel</Button>
            </StackPanel>
            <TextBlock x:Name="Status" Margin="0,2,12,0" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
