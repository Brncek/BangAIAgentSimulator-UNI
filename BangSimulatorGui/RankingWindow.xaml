<Window x:Class="BangSimulatorGui.RankingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent Ranking" Width="980" Height="660" MinWidth="720" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="SettingsPanel" Margin="0,0,0,12">
            <Label Target="{Binding ElementName=CheckpointFolder}" Padding="0,0,0,4">Saved agents folder</Label>
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,3" Click="BrowseFolder_Click">Browse…</Button>
                <TextBox x:Name="CheckpointFolder" Padding="5,3" />
            </DockPanel>

            <UniformGrid Columns="3" Margin="0,12,0,0">
                <StackPanel Margin="0,0,12,0">
                    <Label Target="{Binding ElementName=Method}" Padding="0,0,0,4">Method</Label>
                    <ComboBox x:Name="Method" SelectedIndex="0">
                        <ComboBoxItem Content="Comparison" Tag="comparison" />
                        <ComboBoxItem Content="Uncertainty" Tag="uncertainty" />
                        <ComboBoxItem Content="Fixed games" Tag="fixed" />
                        <ComboBoxItem Content="Elo" Tag="elo" />
                        <ComboBoxItem Content="Overall Elo" Tag="elo-overall"
                                      ToolTip="One leaderboard across all roles using the same team-Elo formula. Role difficulty affects these ratings." />
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <Label Target="{Binding ElementName=Pool}" Padding="0,0,0,4">Opponents</Label>
                    <ComboBox x:Name="Pool" SelectedIndex="0">
                        <ComboBoxItem Content="Mixed" Tag="mixed" />
                        <ComboBoxItem Content="Self-play" Tag="self" />
                    </ComboBox>
                </StackPanel>
                <StackPanel>
                    <Label Target="{Binding ElementName=RankRole}" Padding="0,0,0,4">Focus role</Label>
                    <ComboBox x:Name="RankRole" SelectedIndex="0"
                              ToolTip="All saved agents receive match results. This selects the roles used for uncertainty stopping and comparisons.">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=Method}" Value="2">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=Method}" Value="3">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=Method}" Value="4">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                        <ComboBoxItem Content="All roles" Tag="" />
                        <ComboBoxItem Content="Sheriff" Tag="Sheriff" />
                        <ComboBoxItem Content="Deputy" Tag="Deputy" />
                        <ComboBoxItem Content="Bandit" Tag="Bandit" />
                        <ComboBoxItem Content="Renegade" Tag="Renegade" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,10,12,0">
                    <Label Target="{Binding ElementName=GameLimit}" Padding="0,0,0,4">Total matches (limit)</Label>
                    <TextBox x:Name="GameLimit" Text="2000" Padding="4,2" />
                </StackPanel>
                <StackPanel Margin="0,10,12,0">
                    <Label Target="{Binding ElementName=Precision}" Padding="0,0,0,4">
                        <Label.Style>
                            <Style TargetType="Label">
                                <Setter Property="Content" Value="Equivalence margin (percentage points)" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=Method}" Value="1">
                                        <Setter Property="Content" Value="Precision (percentage points)" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Label.Style>
                    </Label>
                    <TextBox x:Name="Precision" Text="5" Padding="4,2"
                             ToolTip="Comparison can stop when agents are shown to be within this margin. Uncertainty measures each win rate to this precision.">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=Method}" Value="2">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=Method}" Value="3">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=Method}" Value="4">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>
            </UniformGrid>

            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="5 players per game. Mixed — 90% saved agents only; 10% include one Random or Scripted agent." />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=Pool}" Value="1">
                                <Setter Property="Text" Value="5 players per game. Self-play — all five are saved agents from the selected folder." />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Expander Header="Advanced settings" Margin="0,10,0,0">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PythonExecutable" Text="python" Padding="4,2"
                             ToolTip="Python executable with torch, numpy, and msgpack installed." />
                    <Button Grid.Column="1" Margin="8,0,0,0" Padding="10,2" Click="BrowsePython_Click">Browse Python…</Button>

                </Grid>
            </Expander>
        </StackPanel>

        <DataGrid x:Name="Leaderboard" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserSortColumns="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="90" />
                <DataGridTextColumn Header="Rank" Binding="{Binding Rank}" Width="50" />
                <DataGridTextColumn Header="Saved agent" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Wins" Binding="{Binding Wins}" Width="60" />
                <DataGridTextColumn Header="Games" Binding="{Binding Games}" Width="60" />
                <DataGridTextColumn Header="Draws" Binding="{Binding Draws}" Width="60" />
                <DataGridTextColumn x:Name="EloColumn" Header="Elo" Binding="{Binding Elo}" Width="64" Visibility="Collapsed" />
                <DataGridTextColumn Header="Win rate" Binding="{Binding WinRate}" Width="72" />
                <DataGridTextColumn x:Name="ConfidenceColumn" Header="95% interval" Binding="{Binding Interval}" Width="132" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBox x:Name="Comparisons" Grid.Row="2" Margin="0,8,0,0" MaxHeight="120"
                 Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />

        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="RunButton" Width="78" Click="Run_Click">Run</Button>
                <Button x:Name="CancelButton" Width="78" Margin="8,0,0,0" IsEnabled="False" Click="Cancel_Click">Cancel</Button>
            </StackPanel>
            <TextBlock x:Name="Status" Margin="0,2,12,0" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
